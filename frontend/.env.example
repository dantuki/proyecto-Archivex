# Public URL of the API, including /api and without a trailing slash.
# Local development: http://localhost:5000/api
# Production example: https://api.midominio.com/api
# If omitted, the frontend assumes the API is served from the same origin at /api.
VITE_API_URL=https://api.midominio.com/api

# Public reCAPTCHA site key (the secret key stays only in backend/.env).
# The production domain must be registered for this key in the reCAPTCHA admin console.
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
