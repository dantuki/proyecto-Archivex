DB_HOST=localhost
DB_USER=root
DB_PASSWORD=replace_with_your_database_password
DB_NAME=sinfoni_db
DB_PORT=3306

# Use a random value of at least 32 characters.
JWT_SECRET=replace_with_a_long_random_secret
RECAPTCHA_SECRET_KEY=replace_with_your_recaptcha_secret

# SMTP is mandatory for registration verification and password recovery.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=your-address@example.com
MAIL_PASSWORD=replace_with_an_smtp_app_password
MAIL_FROM="ArchiveX <your-address@example.com>"

# Comma-separated origins are accepted by the backend. This origin is used in email links.
FRONTEND_ORIGIN=http://localhost:5173
PORT=5000
NODE_ENV=development
